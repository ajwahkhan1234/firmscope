# ---------------------------------------------------------------------------
# FirmScope environment
# Copy to .env.local for local dev, and add the same three values to your
# Vercel project settings before deploying.
# ---------------------------------------------------------------------------

# Gemini API key — free tier is enough to run this.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# gemini-2.0-flash and gemini-2.5-flash-lite have higher free-tier request
# limits per minute, which helps if you hit 429s mid-run.
GEMINI_MODEL=gemini-2.5-flash

# Supabase — Project Settings > Data API, and Project Settings > API Keys.
# The service-role key is server-only and must never be exposed to the browser.
# It is not prefixed with NEXT_PUBLIC_ for exactly that reason.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
