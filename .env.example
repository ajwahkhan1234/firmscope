# ---------------------------------------------------------------------------
# FirmScope environment
# Copy to .env.local for local dev, and add the same three values to your
# Vercel project settings before deploying.
# ---------------------------------------------------------------------------

# Gemini API key — free tier is enough to run this.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Defaults to gemini-flash-lite-latest.
#
# Two things to know before changing this:
#
#  1. Use an *alias*, not a pinned version. Pinned models get retired —
#     gemini-2.5-flash already returns "no longer available to new users"
#     for newly created keys.
#
#  2. The Gemini free tier bills per model PER DAY, not just per minute.
#     Full Flash (gemini-flash-latest) allows only 20 requests/day, and one
#     teardown uses roughly 15-20 — so it fails partway through the first or
#     second run. The lite alias has a much higher daily ceiling, which is why
#     it is the default.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional. Sustained model requests per minute. Lower this if you see 429s.
GEMINI_REQUESTS_PER_MINUTE=8

# Supabase — Project Settings > Data API, and Project Settings > API Keys.
# The service-role key is server-only and must never be exposed to the browser.
# It is not prefixed with NEXT_PUBLIC_ for exactly that reason.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
